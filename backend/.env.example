# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# PostgreSQL — matches docker-compose.yml (service: db)
DATABASE_URL=postgresql+psycopg://enterprise:enterprise@localhost:5432/enterprise_ai

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Hosted deployments (RENDER=true or ENVIRONMENT=production) refuse to start
# with this placeholder or any value shorter than 16 characters.
SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=your_gemini_api_key_here
DEBUG=false

# Dev only — skip login entirely (every request runs as the seeded demo admin).
# The demo account is created by `alembic upgrade head` (see local setup instructions).
# Leave this false for any real / shared deployment.
AUTH_DISABLED=false

# Comma-separated list of allowed frontend origins (browser CORS + the Online
# Meeting WebSocket's Origin check). Add the deployed frontend's URL, e.g.:
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000

# Set ENVIRONMENT=production on any hosted deployment that is not Render
# (Render sets RENDER=true itself) to enable the production safety checks.
# ENVIRONMENT=production

# --- Permanent file storage (resumes, meeting recordings) ---
# local    = files on this machine's disk (development only — Render wipes it on restart)
# supabase = private Supabase Storage buckets (server-side key; never put it in the frontend)
# STORAGE_BACKEND=local
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# STORAGE_BUCKET_MEETINGS=meeting-recordings
# STORAGE_BUCKET_RESUMES=recruitment-resumes
# SIGNED_URL_TTL_SECONDS=300
# With Supabase's free plan keep uploads under its per-file limit, e.g.:
# MEETING_MAX_UPLOAD_MB=50

# --- Escalations (all optional; defaults shown) ---
# ESCALATION_AUTO_SWEEP=true                    # master switch for automatic checks
# ESCALATION_SCHEDULER_ENABLED=true             # in-process background scheduler
# ESCALATION_SCHEDULER_INTERVAL_SECONDS=300     # how often each worker ticks
# ESCALATION_SWEEP_INTERVAL_SECONDS=300         # at most one sweep per interval, across all workers
# LEAVE_PENDING_ESCALATION_HOURS=48
# ACTION_ITEM_REVIEW_ESCALATION_HOURS=72

# --- Meeting Intelligence / Online Meeting (all optional; defaults shown) ---
# MEETING_TRANSCRIPTION_PROVIDER=whisper         # whisper | gemini — "gemini" sends clips to
#                                               # the Gemini API instead of running Whisper
#                                               # locally; use it on memory-constrained hosts
# MEETING_WHISPER_MODEL=base                    # tiny | base | small | medium | large-v3
# MEETING_WHISPER_LANGUAGE=en                   # ISO 639-1; default is "en" — unset to auto-detect per clip
# MEETING_DIARIZATION_BACKEND=resemblyzer       # resemblyzer | single
MEETING_GEMINI_MODEL=gemini-flash-lite-latest   # a *-lite model has the largest free-tier quota;
#                                               # switch models if one hits its daily limit
# MEETING_STORAGE_DIR=uploads/meetings
# MEETING_MAX_UPLOAD_MB=1024
