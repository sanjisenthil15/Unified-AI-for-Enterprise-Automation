# Copy this file to .env and fill in your values.
# Never commit the actual .env file to version control.

# PostgreSQL — matches docker-compose.yml (service: db)
DATABASE_URL=postgresql+psycopg://enterprise:enterprise@localhost:5432/enterprise_ai

SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=your_gemini_api_key_here
DEBUG=false

# Dev only — skip login entirely (every request runs as the seeded demo admin).
# The demo account is demo@demo.com / Demo1234 (created by `alembic upgrade head`).
# Leave this false for any real / shared deployment.
AUTH_DISABLED=false

# --- Meeting Intelligence / Online Meeting (all optional; defaults shown) ---
# MEETING_WHISPER_MODEL=base                    # tiny | base | small | medium | large-v3
# MEETING_DIARIZATION_BACKEND=resemblyzer       # resemblyzer | single
MEETING_GEMINI_MODEL=gemini-flash-lite-latest   # a *-lite model has the largest free-tier quota;
#                                               # switch models if one hits its daily limit
# MEETING_STORAGE_DIR=uploads/meetings
# MEETING_MAX_UPLOAD_MB=1024
