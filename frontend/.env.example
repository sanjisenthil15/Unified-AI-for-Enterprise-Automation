# Copy to .env and fill in values. Never commit .env to version control.

# Base URL for all API requests — no trailing /api/v1, each api/*.js module
# already prepends it. When deployed, set this to the backend's public URL.
REACT_APP_API_BASE_URL=http://localhost:8000

# Dev only — skip the login screen. The backend must also have AUTH_DISABLED=true.
REACT_APP_AUTH_DISABLED=false
